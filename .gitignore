# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.vite/
.turbo/

# Test output
coverage/
test-results/
playwright-report/
.nyc_output/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# Local Supabase CLI state (contains local DB data)
supabase/.branches/
supabase/.temp/
supabase/.env

# Deployment tooling
.vercel/

# Local agent/tool state
.freebuff/

# Edge cache (non-authoritative local byte cache; derived state, never committed)
.edge-cache/

# Large local media: a downloaded video, not source. Kept out of the tree so build, format and
# lint tooling never has to read it.
*.mp4
*.mov
*.mkv
*.webm
*.mp3

# Local infrastructure credentials — never commit
opendrive-infra-credentials.txt
*-credentials.txt
