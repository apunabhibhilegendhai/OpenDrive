# Pin installed versions exactly and commit the lockfile: reproducible installs.
save-exact=true

# Fail fast on an unsupported Node/pnpm instead of producing confusing build errors.
engine-strict=true

# Keep the store inside the project's parent to avoid OneDrive/user-profile sync churn.
# (Set by developers who need it; pnpm's default global store also works.)
# store-dir=.pnpm-store
