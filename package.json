{
  "name": "opendrive",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDrive — private cloud storage and public file hosting. Monorepo root (Phase 0 foundation).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0 <13"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @opendrive/shared build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && pnpm --filter @opendrive/e2e test:e2e",
    "db:verify": "bash supabase/tests/run-local.sh",
    "db:test:integration": "bash tests/integration/run-local.sh",
    "verify:db": "pnpm db:verify && pnpm db:test:integration",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @opendrive/api dev",
    "dev:web": "pnpm --filter @opendrive/web dev",
    "load": "cd apps/api && node --import tsx load/run.ts",
    "clean": "pnpm -r clean",
    "verify": "pnpm build:libs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
