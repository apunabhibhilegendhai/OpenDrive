# OpenDrive environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never be committed.
# Placeholders only — no real credentials belong in this repository or in any doc.
#
# Phase 1 note: still NO value here is required to start the API, run the CLI, run the unit
# suites or run the end-to-end suite. Every unconfigured integration is reported honestly —
# "not_configured" by GET /readyz, and a 503 with no identity attached by a protected route —
# rather than being guessed at or partially enabled. The two exceptions are the schema suites
# (supabase/tests) and the integration suite (tests/integration), which need a PostgreSQL
# server; both create and drop their own throwaway database.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API (Phase 1 CORS wiring).
CORS_ORIGINS=http://localhost:5173
# Serve OpenAPI docs at /docs and /openapi.json. Defaults to true outside production.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Supabase (existing self-hosted instance) — metadata only, never file contents
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-host.example.com
SUPABASE_ANON_KEY=your-anon-key-placeholder
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# ---------------------------------------------------------------------------
# Metadata database (Phase 1) — the API's own connection
# ---------------------------------------------------------------------------
# Server-side code talks to PostgreSQL directly through this URL; PostgREST is not used, so this
# is not the REST endpoint and not the anon key. Without it, /readyz reports
# postgres: not_configured and every authenticated route fails closed.
# Use a dedicated application role rather than the service role where the instance allows it.
DATABASE_URL=postgres://opendrive_app:your-db-password-placeholder@your-supabase-host.example.com:5432/postgres

# ---------------------------------------------------------------------------
# Access-token verification (Phase 1) — Supabase Auth
# ---------------------------------------------------------------------------
# ONE key source is required for identity. Prefer the JWKS URL (asymmetric keys); the HS256
# shared secret is the self-hosted fallback. With neither, protected routes answer 503 and
# nothing is trusted.
SUPABASE_JWKS_URL=https://your-supabase-host.example.com/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=your-hs256-shared-secret-placeholder
# Expected `iss` and `aud` of an access token. Leave the audience unset for Supabase's default
# of `authenticated`.
SUPABASE_JWT_ISSUER=https://your-supabase-host.example.com/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------------------------------------------------
# Privacy controls (Phase 1)
# ---------------------------------------------------------------------------
# HMAC key for the client-address hashes stored with anonymous sessions and audit events. No
# other value is stored, and a raw address is never written as a fallback: unset simply means
# addresses are not recorded at all. Rotating it invalidates existing hashes, which is the point.
IP_HASH_SECRET=your-random-hmac-key-placeholder
# Lifetime of a newly created anonymous session, in hours (default 168 = 7 days).
ANONYMOUS_SESSION_TTL_HOURS=168
# Origin used when building share links. Not derived from the request: a Host header is
# attacker-controlled, and echoing it back would let a caller mint links pointing elsewhere.
PUBLIC_BASE_URL=https://your-domain.example

# ---------------------------------------------------------------------------
# Redis (existing instance) — rate limiting, caching, short-lived jobs
# ---------------------------------------------------------------------------
REDIS_URL=redis://:your-redis-password@your-redis-host.example.com:6379/0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Which storage provider the API/worker should use. Phase 0 only recognises values below;
# every real provider is implemented in a later phase.
#   none                - no provider configured (default; uploads return 501)
#   memory-test         - process-local test double. NOT durable, NOT for production.
#   telegram-experimental - experimental, not production-validated (see docs/STORAGE-PROVIDERS.md)
STORAGE_PROVIDER=none
STORAGE_MAX_FILE_SIZE_BYTES=2147483648
STORAGE_CHUNK_SIZE_BYTES=8388608

# ---------------------------------------------------------------------------
# Telegram storage backend (EXPERIMENTAL — not production-validated)
# Bot API limits, retention behaviour and account risk are documented in docs/STORAGE-PROVIDERS.md.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=000000000:your-telegram-bot-token-placeholder
TELEGRAM_STORAGE_CHAT_ID=-1000000000000
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Hard ceiling accepted by the Bot API for a single document upload (see provider capability doc).
TELEGRAM_MAX_PART_SIZE_BYTES=1929379840

# ---------------------------------------------------------------------------
# Limits and abuse controls
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
ANONYMOUS_MAX_FILE_SIZE_BYTES=2147483648
ANONYMOUS_UPLOADS_PER_DAY=20
REGISTERED_UPLOADS_PER_DAY=500

# ---------------------------------------------------------------------------
# Moderation / scanning hooks (Phase 4)
# ---------------------------------------------------------------------------
MALWARE_SCAN_ENABLED=false
ABUSE_CONTACT_EMAIL=abuse@your-domain.example
